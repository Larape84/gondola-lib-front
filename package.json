    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "ng-packagr": "^20.3.2",
    "nx": "22.0.4",
    "prettier": "^2.6.2",
    "storybook": "9.1.16",
