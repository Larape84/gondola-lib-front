{
  "name": "@gondola-librery-front/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx run gondola-librery-front:serve:development",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build:libs": "nx run-many --target=build --projects=shared-ui-components-v16,shared-ui-components-v17,shared-ui-components-v18,shared-ui-components-v19,shared-ui-components-v20 --configuration=production",
    "build:lib:v16": "nx build shared-ui-components-v16 --configuration=production",
    "build:lib:v17": "nx build shared-ui-components-v17 --configuration=production",
    "build:lib:v18": "nx build shared-ui-components-v18 --configuration=production",
    "build:lib:v19": "nx build shared-ui-components-v19 --configuration=production",
    "build:lib:v20": "nx build shared-ui-components-v20 --configuration=production",
    "publish:v16": "cd libs/ui/v16/dist && npm publish",
    "publish:v17": "cd libs/ui/v17/dist && npm publish",
    "publish:v18": "cd libs/ui/v18/dist && npm publish",
    "publish:v19": "cd libs/ui/v19/dist && npm publish",
    "publish:v20": "cd libs/ui/v20/dist && npm publish",
    "publish:all": "npm run build:libs && npm run publish:v16 && npm run publish:v17 && npm run publish:v18 && npm run publish:v19 && npm run publish:v20"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~20.3.0",
