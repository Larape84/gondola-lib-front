{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "target": "es2020",
    "baseUrl": ".",
    "paths": {
      "@primeng-v17": ["../../../node_modules/primeng-v17"],
      "@primeng-v17/*": ["../../../node_modules/primeng-v17/*"]
    }
  },
  "exclude": ["src/**/*.spec.ts", "jest.config.ts", "src/**/*.test.ts"],
  "include": ["src/**/*.ts"]
}
